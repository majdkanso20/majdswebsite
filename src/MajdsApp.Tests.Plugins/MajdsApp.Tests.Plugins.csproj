<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The runtime-plugin tests live in their own test project (so their own process) on purpose. EF Core
    builds and caches the model once per process, from whichever assemblies are loaded at that moment.
    A plugin's entity is only in the model if the plugin was loaded before the first DbContext use, so
    running these next to tests that build the model without the plugin made them fail intermittently.
    Separate processes make the outcome deterministic, as it is in a real deployment.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="FluentAssertions" Version="7.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MajdsApp.Api\MajdsApp.Api.csproj" />
    <!-- Built (not referenced): the tests copy its output into a temporary plugins folder and load it at runtime. -->
    <ProjectReference Include="..\MajdsApp.Plugins.Tasks\MajdsApp.Plugins.Tasks.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same test harness (app factory, API client) as the main test project. -->
    <Compile Include="..\MajdsApp.Tests\Support\*.cs" Link="Support\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
